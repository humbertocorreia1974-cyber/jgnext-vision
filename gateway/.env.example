# Cameras a monitorar: nome=rtsp_url, separadas por ";"
# Exemplo com 2 cameras:
CAMERA_RTSP_URLS=entrada=rtsp://admin:senha@192.168.1.10:554/stream1;patio=rtsp://admin:senha@192.168.1.11:554/stream1

# URL do webhook do SEU app publicado + token (pegue em Configuracoes >
# Variaveis de Ambiente no painel do JGNEXT, campo CAMERA_GATEWAY_TOKEN)
APP_WEBHOOK_URL=https://SEU-APP.vercel.app/api/camera-events
APP_WEBHOOK_TOKEN=

# Quais deteccoes contam como evento (rotulos: person, bicycle, car,
# motorcycle, bus, truck, cat, dog)
DETECTION_CLASSES=person,car,truck,motorcycle
CONFIDENCE_THRESHOLD=0.6

# Intervalo minimo entre eventos da MESMA camera, em segundos (evita
# tempestade de eventos quando ha movimento continuo)
EVENT_COOLDOWN_SECONDS=15
